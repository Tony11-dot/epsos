# ── Admin auth ────────────────────────────────────────────────────────────
# Password for the /admin panel.
ADMIN_PASSWORD=change-me
# Secret used to sign the session cookie (any long random string).
SESSION_SECRET=please-change-this-to-a-long-random-string

# ── Content store ─────────────────────────────────────────────────────────
# STORE_DRIVER: "local" (JSON files, default in dev) | "redis" (Upstash, prod)
STORE_DRIVER=local

# Upstash Redis (only needed when STORE_DRIVER=redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Image uploads ─────────────────────────────────────────────────────────
# BLOB_DRIVER: "local" (writes to /public/uploads, default in dev) | "blob" (Vercel Blob, prod)
BLOB_DRIVER=local
# Vercel Blob (only needed when BLOB_DRIVER=blob)
BLOB_READ_WRITE_TOKEN=

# ── Registrations → Google Sheets ─────────────────────────────────────────
# Apps Script Web App URL that appends form submissions to the sheet.
# See docs/apps-script.gs for the 2-minute setup. Leave empty to store only
# a local copy at content/registrations.json (dev).
SHEETS_WEBHOOK_URL=
